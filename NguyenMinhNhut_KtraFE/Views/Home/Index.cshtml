@{
    ViewBag.Title = "Product List";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Amazon - Product List</title>

    <!-- Font Awesome 5.15.4 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <!-- CSS của bài -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/ProductList.css")" />
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="amazon-header">

        <div class="amazon-logo">
            amazon<span>.com</span>
        </div>

        <div class="deliver">
            <i class="fas fa-map-marker-alt"></i>

            <div>
                <small>Deliver to</small>
                <strong>Vietnam</strong>
            </div>
        </div>

        <div class="search-box">

            <select>
                <option>All</option>
                <option>Appliances</option>
                <option>Home</option>
                <option>Tools</option>
            </select>

            <input type="text"
                   value="cleaning tools"
                   placeholder="Search Amazon" />

            <button>
                <i class="fas fa-search"></i>
            </button>

        </div>

        <div class="language">
            🇺🇸
            <b>EN</b>
            <i class="fas fa-caret-down"></i>
        </div>

        <div class="header-account">
            <small>Hello, sign in</small>
            <strong>
                Account & Lists
                <i class="fas fa-caret-down"></i>
            </strong>
        </div>

        <div class="header-orders">
            <small>Returns</small>
            <strong>& Orders</strong>
        </div>

        <div class="header-cart">
            <i class="fas fa-shopping-cart"></i>
            <strong>Cart</strong>
        </div>

    </header>


    <!-- ================= NAVIGATION ================= -->

    <nav class="amazon-nav">

        <div>
            <i class="fas fa-bars"></i>
            All
        </div>

        <div>Today's Deals</div>
        <div>Customer Service</div>
        <div>Registry</div>
        <div>Gift Cards</div>
        <div>Sell</div>

    </nav>


    <!-- ================= RESULT ================= -->

    <div class="result-bar">

        <div>
            1-48 of over 40,000 results for
            <strong>"cleaning tools"</strong>
        </div>

        <button class="sort-button">
            Sort by: Featured
            <i class="fas fa-chevron-down"></i>
        </button>

