    <main class="main-container">

        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <h3>Popular Shopping ideas</h3>

            <a href="#">Window</a>
            <a href="#">Bathing</a>
            <a href="#">Household</a>
            <a href="#">Tile</a>
            <a href="#" class="see-more">See more</a>


            <hr />


            <h3>Customer Reviews</h3>

            <div class="review-filter">
                <span>★★★★★</span>
                <label>& Up</label>
            </div>


            <hr />


            <h3>Deals & Discounts</h3>

            <a href="#">Today's Deals</a>


            <hr />


            <h3>Price</h3>

            <a href="#">Under $10</a>
            <a href="#">$10 to $15</a>
            <a href="#">$15 to $25</a>
            <a href="#">$25 to $35</a>
            <a href="#">$35 & Above</a>

            <div class="price-slider">
                <input type="range" min="0" max="100" value="15" />

                <div class="price-values">
                    <span>$0</span>
                    <span>$510</span>
                </div>
            </div>


            <hr />


            <h3>Department</h3>

            <a href="#">Household Cleaning Tools</a>
            <a href="#">Household Cleaning Brushes</a>
            <a href="#">Household Mops, Buckets & Accessories</a>

